# Credenciais e chaves de API (NUNCA versionar!)
.env
.env.local
**/.env
**/.env.local
.config.json
**/.config.json

# Arquivos de backup temporários
*.bak*
**/*.bak*

# Cache do Python
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# Arquivos temporários de lock/journal do SQLite
*.db-journal
*.db-wal
*.db-shm

# Arquivos de sistema operacional e editores
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Motor novo (_app/backend)
_app/backend/.venv/
*.egg-info/
.superpowers/
# Índice de busca (derivável, reconstruído pelo app)
**/.indice/

# Frontend (Fase 5)
_app/frontend/node_modules/
_app/frontend/dist/
_app/frontend/test-results/
_app/frontend/playwright-report/

# Modelos de embeddings baixados (Fase 6)
_app/.modelos/

# amostras de páginas reais (texto de livros e slides de terceiros): só locais, nunca no repositório
_app/backend/tests/fixtures/paginas/

# Chave da API do Gemini (assistente, Fase 6): nunca no repositório
_app/.segredos.toml

# Matérias (PDFs, resumos, marcações): dados pessoais, ficam só no computador.
# Toda pasta da raiz fica fora, menos as do app, da documentação e o modelo vazio.
/*/
!/_app/
!/docs/
!/.github/
!/_modelo-materia/
