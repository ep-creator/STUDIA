.historico_undo.json
**/.historico_undo.json
.historico_telemetria.json
**/.historico_telemetria.json

# Arquivos temporários de lock/journal do SQLite
*.db-journal
*.db-wal
*.db-shm

# Arquivos de sistema operacional e editores
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

